# ============================================================
# Joy Spark Toys — Environment Variables
# ============================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in YOUR values from Supabase:
#    https://app.supabase.com → Your Project → Settings → API
# ============================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_SITE_URL=https://joysparktoys.com

# Meta Pixel
VITE_META_PIXEL_ID=1469475641884487
VITE_META_TEST_EVENT_CODE=

# Google Analytics 4
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity (loads only in production)
VITE_MICROSOFT_CLARITY_ID=xxxxxxxxxx

# Supabase Conversion API Edge Function (set to 'true' after deploying the function)
VITE_META_CAPI_ENABLED=false

# ============================================================
# OTP Auth (2Factor.in) — Secrets stored as Supabase Edge Function secrets
# ============================================================
# These are NOT frontend env vars. Set them via Supabase CLI:
#   supabase secrets set TWOFACTOR_API_KEY=your_2factor_api_key_here
#   supabase secrets set OTP_AUTH_SECRET=generate_a_random_string_here
#
# Get your 2Factor.in API key from: https://2factor.in/
# ============================================================
